<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.one-min-adapter</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/<user>/.hermes/hermes-agent/venv/bin/python3</string>
        <string>/Users/<user>/repos/one-min-adapter/one_min_adapter.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>ONEMIN_PORT</key>
        <string>8400</string>
        <key>ONEMIN_KEY_FILE</key>
        <string>/Users/<user>/.hermes/secrets/1min.key</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/<user>/.hermes/logs/one-min-adapter.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/<user>/.hermes/logs/one-min-adapter.err.log</string>
</dict>
</plist>
